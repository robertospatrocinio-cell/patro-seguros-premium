    # Hubs de bairro (variações de slug)
    RewriteRule ^seguros-guarulhos/centro-guarulhos/?$ /seguros-guarulhos/centro [R=301,L,NC]
    RewriteRule ^seguros-guarulhos/taboao-guarulhos/?$ /seguros-guarulhos/taboao [R=301,L,NC]
    RewriteRule ^seguros-guarulhos/macedo-guarulhos/?$ /seguros-guarulhos/macedo [R=301,L,NC]
    RewriteRule ^seguros-guarulhos/gopouva-guarulhos/?$ /seguros-guarulhos/gopouva [R=301,L,NC]
    RewriteRule ^seguros-guarulhos/picanco-guarulhos/?$ /seguros-guarulhos/picanco [R=301,L,NC]
    RewriteRule ^seguros-guarulhos/jardim-cidade-maia/?$ /seguros-guarulhos/cidade-maia [R=301,L,NC]
    RewriteRule ^seguros-guarulhos/cidade-jardim-maia/?$ /seguros-guarulhos/jardim-maia [R=301,L,NC]
    # Produto×bairro — Residencial
    RewriteRule ^seguro-residencial-centro/?$ /seguro-residencial-centro-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-residencial-taboao/?$ /seguro-residencial-taboao-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-residencial-macedo/?$ /seguro-residencial-macedo-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-residencial-gopouva/?$ /seguro-residencial-gopouva-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-residencial-picanco/?$ /seguro-residencial-picanco-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-residencial-cumbica-guarulhos/?$ /seguro-residencial-cumbica [R=301,L,NC]
    RewriteRule ^seguro-residencial-bonsucesso-guarulhos/?$ /seguro-residencial-bonsucesso [R=301,L,NC]
    RewriteRule ^seguro-residencial-pimentas-guarulhos/?$ /seguro-residencial-pimentas [R=301,L,NC]
    RewriteRule ^seguro-residencial-vila-augusta-guarulhos/?$ /seguro-residencial-vila-augusta [R=301,L,NC]
    RewriteRule ^seguro-residencial-jardim-maia-guarulhos/?$ /seguro-residencial-jardim-maia [R=301,L,NC]
    RewriteRule ^seguro-residencial-cidade-maia-guarulhos/?$ /seguro-residencial-cidade-maia [R=301,L,NC]
    # Produto×bairro — Vida
    RewriteRule ^seguro-vida-centro/?$ /seguro-vida-centro-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-vida-taboao/?$ /seguro-vida-taboao-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-vida-macedo/?$ /seguro-vida-macedo-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-vida-gopouva/?$ /seguro-vida-gopouva-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-vida-picanco/?$ /seguro-vida-picanco-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-vida-cumbica-guarulhos/?$ /seguro-vida-cumbica [R=301,L,NC]
    RewriteRule ^seguro-vida-bonsucesso-guarulhos/?$ /seguro-vida-bonsucesso [R=301,L,NC]
    RewriteRule ^seguro-vida-pimentas-guarulhos/?$ /seguro-vida-pimentas [R=301,L,NC]
    RewriteRule ^seguro-vida-vila-augusta-guarulhos/?$ /seguro-vida-vila-augusta [R=301,L,NC]
    RewriteRule ^seguro-vida-jardim-maia-guarulhos/?$ /seguro-vida-jardim-maia [R=301,L,NC]
    RewriteRule ^seguro-vida-cidade-maia-guarulhos/?$ /seguro-vida-cidade-maia [R=301,L,NC]
    # Produto×bairro — Empresarial
    RewriteRule ^seguro-empresarial-centro/?$ /seguro-empresarial-centro-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-empresarial-taboao/?$ /seguro-empresarial-taboao-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-empresarial-macedo/?$ /seguro-empresarial-macedo-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-empresarial-gopouva/?$ /seguro-empresarial-gopouva-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-empresarial-picanco/?$ /seguro-empresarial-picanco-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-empresarial-cumbica-guarulhos/?$ /seguro-empresarial-cumbica [R=301,L,NC]
    RewriteRule ^seguro-empresarial-bonsucesso-guarulhos/?$ /seguro-empresarial-bonsucesso [R=301,L,NC]
    RewriteRule ^seguro-empresarial-pimentas-guarulhos/?$ /seguro-empresarial-pimentas [R=301,L,NC]
    RewriteRule ^seguro-empresarial-vila-augusta-guarulhos/?$ /seguro-empresarial-vila-augusta [R=301,L,NC]
    RewriteRule ^seguro-empresarial-jardim-maia-guarulhos/?$ /seguro-empresarial-jardim-maia [R=301,L,NC]
    RewriteRule ^seguro-empresarial-cidade-maia-guarulhos/?$ /seguro-empresarial-cidade-maia [R=301,L,NC]

    # Short branded URL -> Segfy quote form (302 temporary; may change in the future)
    RewriteRule ^cotacao-auto/?$ https://villa.segfy.com/Publico/Segurados/Orcamentos/SolicitarCotacao?e=t6RDiR%2F1ioARkspweLWOgQ%3D%3D [R=302,L,NE]

    # Redirects específicos migrados para o bloco gerado abaixo
    # (destinos antigos tinham barra final e criavam chain de 2 saltos).

    # >>> BEGIN generated-redirects (scripts/sync-htaccess-redirects.mjs)
    # NÃO EDITAR À MÃO — gerado de src/lib/redirects.ts

    # 301 — conteúdo com substituto semanticamente equivalente (1 salto)
    RewriteRule ^seguros-cidade-maia-guarulhos/?$ /seguros-shopping-maia-cidade-maia-guarulhos [R=301,L,NC]
    RewriteRule ^planos-de-saude/?$ /plano-de-saude-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-saude/?$ /plano-de-saude-guarulhos [R=301,L,NC]
    RewriteRule ^plano-de-saude/?$ /plano-de-saude-guarulhos [R=301,L,NC]
    RewriteRule ^seguros-em-guarulhos/?$ /seguros-guarulhos [R=301,L,NC]
    RewriteRule ^corretora-de-seguros-em-guarulhos/?$ /seguros-guarulhos [R=301,L,NC]
    RewriteRule ^seguro-transporte/?$ /seguro-transporte-carga-guarulhos [R=301,L,NC]
    RewriteRule ^nossos-parceiros/?$ /parceiros [R=301,L,NC]
    RewriteRule ^politica-de-privacidade/?$ /politica-privacidade [R=301,L,NC]
    RewriteRule ^previdencia/?$ /previdencia-privada [R=301,L,NC]
    RewriteRule ^odonto-personal/?$ /seguro-odonto [R=301,L,NC]

    # 301 — unificação /artigos/{slug} → /blog/{slug} preservando o slug
    RewriteRule ^artigos/([^/]+)/?$ /blog/$1 [R=301,L,NC]

    # 410 — conteúdo removido definitivamente, sem substituto equivalente
    RewriteRule ^tag(/.*)?$ - [G,L,NC]
    RewriteRule ^category(/.*)?$ - [G,L,NC]
    RewriteRule ^author(/.*)?$ - [G,L,NC]
    RewriteRule (^|/)feed/?$ - [G,L,NC]
    RewriteRule ^wp-(content|admin|includes|json)(/.*)?$ - [G,L,NC]
    RewriteRule ^[0-9]{4}/[0-9]{2}(/.*)?$ - [G,L]
    # <<< END generated-redirects

    # Strip trailing slash on non-asset URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} ^/.+/$
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Exclude existing files/special routes from SPA fallback
    RewriteRule ^(sitemap[^/]*\.xml|robots\.txt|sw\.js|favicon\.(ico|png)|manifest\.webmanifest)$ - [L,NC]
  
    # Any sitemap*.xml that does not exist on disk must 404
    RewriteCond %{REQUEST_URI} ^/sitemap[^/]*\.xml$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ - [R=404,L]
  
    # ----------------------------------------------------------------------
    # | SPA Fallback and Real 404 Handling                                 |
    # ----------------------------------------------------------------------

    # 1. If the exact file or directory exists (including pre-rendered index.html), serve it
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Internal/Admin routes should ALWAYS use index.html (SPA mode)
    # These routes are NOT pre-rendered.
    RewriteCond %{REQUEST_URI} ^/(admin|crm|purge-logs|performance-diagnostico|conversion-dashboard|seo-technical-report|pagespeed-history|preview) [NC]
    RewriteRule ^ index.html [L]

    # 3. Specific landing pages / commercial pages fallback
    # ONLY if the pre-rendered file does not exist (safety net).
    RewriteCond %{REQUEST_URI} ^/(lp|landing|cotacao-seguro|promocao) [NC]
    RewriteRule ^ index.html [L]
  
    # 4. For everything else that is NOT a file and NOT an internal route:
    # Since we are pre-rendering everything in the sitemap, if it's not a file, it's a 404.
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ - [R=404,L]
  </IfModule>
  
  # Ensure the error page itself returns 404 status
  ErrorDocument 404 /404.html
