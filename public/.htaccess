    RewriteRule ^seguro-auto-ferrari/?$ /seguro-ferrari [R=301,L,NC]
    RewriteRule ^seguro-auto-porsche/?$ /seguro-porsche [R=301,L,NC]
    RewriteRule ^seguro-auto-byd/?$ /seguro-byd [R=301,L,NC]
    RewriteRule ^seguro-auto-gwm/?$ /seguro-gwm [R=301,L,NC]
    RewriteRule ^seguro-gmw/?$ /seguro-gwm [R=301,L,NC]
