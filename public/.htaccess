    RewriteRule ^seguro-auto-guarulhos/?$ /lp/seguro-auto-guarulhos [R=301,L,NC]

    # ----------------------------------------------------------------------
    # | 301 legados de bairros e produto×bairro (Guarulhos)                |
    # | Fonte única: src/lib/legacyBairroRedirects.ts (espelhado em SPA).  |
