 # Hostinger / LiteSpeed friendly SPA routing
 <IfModule LiteSpeed>
   CacheLookup on
   CacheEngine on
 </IfModule>
 
 <IfModule mod_rewrite.c>
   RewriteEngine On
   RewriteBase /
   
   # Force apex -> www and HTTPS in one go for maximum efficiency
   RewriteCond %{HTTP_HOST} ^patroseguros\.com\.br$ [NC,OR]
   RewriteCond %{HTTPS} !=on
   RewriteRule ^(.*)$ https://www.patroseguros.com.br/$1 [R=301,L]
 </IfModule>
 
 DirectoryIndex index.html
 Options -MultiViews +FollowSymLinks
 
  # Set MIME types
  <IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/json .json
    AddType application/xml .xml
    AddType text/plain .txt
    AddType image/svg+xml .svg
    AddCharset UTF-8 .xml .txt .html .js .css .json
  </IfModule>
 
 # ----------------------------------------------------------------------
 # | Compression and Pre-compressed Static Assets                       |
 # ----------------------------------------------------------------------
 
 <IfModule mod_rewrite.c>
   RewriteEngine On
   RewriteBase /
 
   # Serve Brotli-compressed files if they exist and the client supports Brotli.
   RewriteCond %{HTTP:Accept-Encoding} br
   RewriteCond %{REQUEST_FILENAME}.br -f
   RewriteRule ^(.*)$ $1.br [L]
   
    # Set correct content type and encoding for .br files and add cache headers
    <FilesMatch "\.js\.br$">
      Header set Content-Type "application/javascript"
      Header set Content-Encoding br
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.css\.br$">
      Header set Content-Type "text/css"
      Header set Content-Encoding br
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html\.br$">
      Header set Content-Type "text/html"
      Header set Content-Encoding br
      Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.svg\.br$">
      Header set Content-Type "image/svg+xml"
      Header set Content-Encoding br
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.json\.br$">
      Header set Content-Type "application/json"
      Header set Content-Encoding br
      Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    </FilesMatch>
  
    # Serve Gzip-compressed files if Brotli is not supported and .gz files exist.
    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.*)$ $1.gz [L]
    
    <FilesMatch "\.js\.gz$">
      Header set Content-Type "application/javascript"
      Header set Content-Encoding gzip
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.css\.gz$">
      Header set Content-Type "text/css"
      Header set Content-Encoding gzip
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html\.gz$">
      Header set Content-Type "text/html"
      Header set Content-Encoding gzip
      Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.svg\.gz$">
      Header set Content-Type "image/svg+xml"
      Header set Content-Encoding gzip
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.json\.gz$">
      Header set Content-Type "application/json"
      Header set Content-Encoding gzip
      Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    </FilesMatch>
  </IfModule>
 
 <IfModule mod_expires.c>
   ExpiresActive On
   ExpiresDefault "access plus 2 days"
   ExpiresByType text/html "access plus 1 hour"
   ExpiresByType text/css "access plus 1 year"
   ExpiresByType application/javascript "access plus 1 year"
   ExpiresByType application/x-javascript "access plus 1 year"
   ExpiresByType text/javascript "access plus 1 year"
   ExpiresByType image/webp "access plus 1 year"
   ExpiresByType image/png "access plus 1 year"
   ExpiresByType image/jpeg "access plus 1 year"
   ExpiresByType image/x-icon "access plus 1 year"
   ExpiresByType image/svg+xml "access plus 1 year"
   ExpiresByType font/woff2 "access plus 1 year"
   ExpiresByType font/woff "access plus 1 year"
   ExpiresByType application/json "access plus 1 day"
 </IfModule>
 
 <IfModule mod_headers.c>
   # Static assets with hashes (immutable) - including compressed versions
   <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2|woff|ttf|avif)(\.(br|gz))?$">
     Header set Cache-Control "public, max-age=31536000, immutable"
     Header unset ETag
     Header set X-Content-Type-Options "nosniff"
     # Help CDNs and proxies serve the correct compressed version
     Header append Vary Accept-Encoding
   </FilesMatch>
 
   # HTML and data files
   <FilesMatch "\.(html|json|txt)$">
     Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
     Header append Vary Accept-Encoding
   </FilesMatch>
 
   # Specific handling for robots.txt and sitemaps
   <FilesMatch "robots\.txt">
     Header set Cache-Control "public, max-age=86400"
   </FilesMatch>
   <FilesMatch "sitemap.*\.xml">
     Header set Cache-Control "public, max-age=86400"
     Header append Vary Accept-Encoding
   </FilesMatch>
 
   # Service worker must NOT be cached long-term
   <FilesMatch "sw\.js">
     Header set Cache-Control "public, max-age=0, no-cache, no-store, must-revalidate"
   </FilesMatch>
 
   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
   Header always set X-Content-Type-Options "nosniff"
   Header always set X-Frame-Options "SAMEORIGIN"
   Header always set Referrer-Policy "strict-origin-when-cross-origin"
 </IfModule>
 
 <IfModule mod_brotli.c>
   AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml text/xml application/xml application/manifest+json text/plain
 </IfModule>
 
 <IfModule mod_deflate.c>
   AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml application/manifest+json text/plain font/woff2
 </IfModule>
 
    # ----------------------------------------------------------------------
    # | Redirects for legacy / non-canonical URLs                          |
    # ----------------------------------------------------------------------
    
    # Legacy WordPress and SEO URL cleanup (Redirecting to final canonical path)
    RewriteRule ^seguro-maquinas-e-equipamentos-2/?$ /seguro-maquinas-industriais [R=301,L]
    RewriteRule ^seguro-residencial-2/?$ /seguro-residencial [R=301,L]
    RewriteRule ^seguro-empresarial-2/?$ /seguro-empresarial [R=301,L]
    RewriteRule ^seguro-auto-2/?$ /seguro-auto [R=301,L]
    RewriteRule ^seguro-vida-2/?$ /seguro-vida [R=301,L]
    RewriteRule ^([a-z0-9-]+)-2/?$ /$1 [R=301,L,NC]

    # Specific SEO-friendly redirects (Moved from client-side to server-side)
    RewriteRule ^seguro-auto-bmw/?$ /seguro-bmw [R=301,L,NC]
    RewriteRule ^seguro-auto-mercedes/?$ /seguro-mercedes [R=301,L,NC]
    RewriteRule ^seguro-auto-audi/?$ /seguro-audi [R=301,L,NC]
