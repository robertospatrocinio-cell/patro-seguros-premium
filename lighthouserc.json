{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "staticDistDir": "./dist",
      "settings": {
        "emulatedFormFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "requestLatencyMs": 150,
          "downloadThroughputKbps": 1638.4,
          "uploadThroughputKbps": 675.8
        }
      },
      "url": [
        "http://localhost/",
        "http://localhost/seguro-auto-guarulhos/",
        "http://localhost/seguro-residencial-guarulhos/",
        "http://localhost/seguro-vida-saude-guarulhos/",
        "http://localhost/plano-de-saude-guarulhos/",
        "http://localhost/seguro-empresarial-guarulhos/",
        "http://localhost/seguro-frota-empresas-guarulhos/",
        "http://localhost/seguro-condominio-guarulhos/",
        "http://localhost/consorcio-guarulhos/"
      ]
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
